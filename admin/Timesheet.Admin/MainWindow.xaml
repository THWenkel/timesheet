<Window x:Class="Timesheet.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Timesheet Administration"
        Height="680"
        Width="1080"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock FontFamily="Bahnschrift SemiBold"
                       FontSize="28"
                       Foreground="#17221F"
                       Text="Benutzerverwaltung" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#5B6864"
                       Text="Mitarbeiterzugänge für das Timesheet verwalten" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding AddCommand}"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Content="＋ Neu" />
            <Button Command="{Binding EditCommand}" Content="✎ Bearbeiten" />
            <Button Command="{Binding DeactivateCommand}" Content="⊘ Deaktivieren" />
            <Button Command="{Binding LoadCommand}" Content="↻ Aktualisieren" />
            <Button Command="{Binding OpenProjectsCommand}"
                    Margin="12,0,0,0"
                    Content="Projekte" />
                <Button Command="{Binding OpenCustomersCommand}" Content="Kunden" />
            <Button Click="Exit_Click" Margin="12,0,0,0" Content="Beenden" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,7"
                       FontFamily="Bahnschrift SemiBold" FontSize="16"
                       Text="Benutzer" />
            <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#D8DEDB"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      AlternatingRowBackground="#F7F9F8">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="PreviewMouseRightButtonDown"
                                     Handler="DataGridRow_PreviewMouseRightButtonDown" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Neu" Command="{Binding AddCommand}" />
                        <Separator />
                        <MenuItem Header="Bearbeiten" Command="{Binding EditCommand}" />
                        <MenuItem Header="Deaktivieren" Command="{Binding DeactivateCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Vorname" Binding="{Binding Surname}" Width="*" />
                    <DataGridTextColumn Header="Nachname" Binding="{Binding Lastname}" Width="*" />
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="100" />
                    <DataGridTextColumn Header="Geändert"
                                        Binding="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="170" />
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <TextBlock Grid.Row="2" Margin="0,18,0,7"
                       FontFamily="Bahnschrift SemiBold" FontSize="16"
                       Text="Zugeordnete Projekte" />
            <Border Grid.Row="3"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#D8DEDB"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid ItemsSource="{Binding EmployeeProjects}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          AlternatingRowBackground="#F7F9F8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Projekt" Binding="{Binding Name}" Width="1.4*" />
                        <DataGridTextColumn Header="Kunde" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Budget" Binding="{Binding BudgetDisplay}" Width="120" />
                        <DataGridTextColumn Header="Von"
                                            Binding="{Binding StartsOn, StringFormat={}{0:dd.MM.yyyy}}"
                                            Width="105" />
                        <DataGridTextColumn Header="Bis"
                                            Binding="{Binding EndsOn, StringFormat={}{0:dd.MM.yyyy}}"
                                            Width="105" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Foreground="#A12828"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
            <TextBlock HorizontalAlignment="Right"
                       Foreground="#5B6864"
                       Text="{Binding StatusText}" />
        </Grid>

    </Grid>
</Window>

<Window x:Class="Timesheet.Admin.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzer bearbeiten"
        Width="440"
        Height="450"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,6" Text="Vorname" />
        <TextBox Grid.Row="1"
                 Padding="8"
                 Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,6" Text="Nachname" />
            <TextBox Padding="8"
                     Text="{Binding Lastname, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,16,0,6" Text="Benutzername (Login)" />
            <TextBox Padding="8"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="0,18,0,0"
                      Content="Benutzer ist aktiv"
                      IsChecked="{Binding IsActive}" />
            <CheckBox Margin="0,10,0,0"
                      Content="Administrator (darf das Admin-Tool und die Datensicherung nutzen)"
                      IsChecked="{Binding IsAdmin}" />
        </StackPanel>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#A12828" />

        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button IsCancel="True" Content="Abbrechen" />
            <Button IsDefault="True"
                    Margin="0"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Click="Save_Click"
                    Content="Speichern" />
        </StackPanel>
    </Grid>
</Window>
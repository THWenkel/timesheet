<Window x:Class="Timesheet.Admin.Views.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt bearbeiten"
        Width="650"
        Height="860"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,8,12,14" Text="Projektname" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Margin="0,8,12,14" Text="Kunde" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" Padding="7"
                          IsEditable="False"
                          ItemsSource="{Binding CustomerNames}"
                          SelectedItem="{Binding CustomerName}" />

                <TextBlock Grid.Row="2" Margin="0,8,12,14" Text="Beschreibung" />
                <TextBox Grid.Row="2" Grid.Column="1" Height="86" Margin="0,0,0,14" Padding="8"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Margin="0,8,12,14" Text="Purchase Number" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding PurchaseNumber, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Margin="0,8,12,14" Text="Abladestelle" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding UnloadingPoint, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Margin="0,8,12,14" Text="Verbrauchswerk" />
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding ConsumingPlant, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6" Margin="0,8,12,14" Text="Ansprechpartner" />
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="7" Margin="0,8,12,14" Text="Telefon" />
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="8" Margin="0,8,12,14" Text="E-Mail" />
                <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,0,14" Padding="8"
                         Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="9" Margin="0,8,12,14" Text="Preise" />
                <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#5B6864" Text="Preis je Stunde" />
                        <TextBox Padding="8" Text="{Binding HourlyRate, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#5B6864" Text="Tagessatz" />
                        <TextBox Padding="8" Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Grid>

                <TextBlock Grid.Row="10" Margin="0,8,12,14" Text="Budget" />
                <Grid Grid.Row="10" Grid.Column="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBox Padding="8" Text="{Binding BudgetAmount, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="2" Padding="7"
                              ItemsSource="{Binding BudgetUnits}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding BudgetUnit}" />
                </Grid>

                <TextBlock Grid.Row="11" Margin="0,8,12,14" Text="Laufzeit von" />
                <DatePicker Grid.Row="11" Grid.Column="1" Margin="0,0,0,14"
                            SelectedDate="{Binding StartsOn}" />

                <TextBlock Grid.Row="12" Margin="0,8,12,14" Text="Laufzeit bis" />
                <DatePicker Grid.Row="12" Grid.Column="1" Margin="0,0,0,14"
                            SelectedDate="{Binding EndsOn}" />

                <TextBlock Grid.Row="13" Margin="0,8,12,14" Text="Status" />
                <ComboBox Grid.Row="13" Grid.Column="1" Margin="0,0,0,14" Padding="7"
                          ItemsSource="{Binding Statuses}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Status}" />

                <TextBlock Grid.Row="14" Margin="0,8,12,14" Text="Benutzer" />
                <Border Grid.Row="14" Grid.Column="1" Height="150" Margin="0,0,0,14"
                        Background="White" BorderBrush="#C8CFCC" BorderThickness="1">
                    <ListBox ItemsSource="{Binding Assignments}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="8,5"
                                          Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsAssigned}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="ValidationMessage" Grid.Row="15" Grid.ColumnSpan="2"
                           Foreground="#A12828" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button IsCancel="True" Content="Abbrechen" />
            <Button IsDefault="True" Margin="0"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    Click="Save_Click" Content="Speichern" />
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="Timesheet.Admin.Views.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kunde bearbeiten"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Margin="0,0,0,6" Text="Kundenname" />
                <TextBox Padding="8"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,18,0,8" FontFamily="Bahnschrift SemiBold"
                           FontSize="16" Text="Adresse" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Straße 1" />
                    <TextBox Grid.Row="1" Margin="0,6,0,12" Padding="8"
                             Text="{Binding Street1, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Straße 2" />
                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,6,0,12" Padding="8"
                             Text="{Binding Street2, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="PLZ" />
                    <TextBox Grid.Row="3" Margin="0,6,0,12" Padding="8"
                             Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Ort" />
                    <TextBox Grid.Row="3" Grid.Column="2" Margin="0,6,0,12" Padding="8"
                             Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Text="Land" />
                    <ComboBox Grid.Row="5" Margin="0,6,0,0" Padding="7"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              ItemsSource="{Binding FilteredCountryCodes}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="CountryCode"
                              SelectedValue="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Margin="0,18,0,8" FontFamily="Bahnschrift SemiBold"
                           FontSize="16" Text="Kaufmännische Daten" />
                <TextBlock Text="Supplier Number" />
                <TextBox Margin="0,6,0,0" Padding="8"
                         Text="{Binding SupplierNumber, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,18,0,8" FontFamily="Bahnschrift SemiBold"
                           FontSize="16" Text="Ansprechpartner" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Name" />
                    <TextBox Grid.Row="1" Margin="0,6,0,12" Padding="8"
                             Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Telefon" />
                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,6,0,12" Padding="8"
                             Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="E-Mail" />
                    <TextBox Grid.Row="3" Margin="0,6,0,0" Padding="8"
                             Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Margin="0,18,0,6" Text="Notizen" />
                <TextBox Height="90" Padding="8" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Margin="0,18,0,0" Content="Kunde ist aktiv"
                          IsChecked="{Binding IsActive}" />
                <TextBlock x:Name="ValidationMessage" Margin="0,12,0,0"
                           Foreground="#A12828" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,18,0,0"
                    HorizontalAlignment="Right" Orientation="Horizontal">
            <Button IsCancel="True" Content="Abbrechen" />
            <Button IsDefault="True" Margin="0"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    Click="Save_Click" Content="Speichern" />
        </StackPanel>
    </Grid>
</Window>
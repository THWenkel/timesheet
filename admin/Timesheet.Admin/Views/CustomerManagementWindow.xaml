<Window x:Class="Timesheet.Admin.Views.CustomerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kundenverwaltung"
        Width="900"
        Height="600"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock FontFamily="Bahnschrift SemiBold" FontSize="28" Text="Kundenverwaltung" />
            <TextBlock Margin="0,6,0,0" Foreground="#5B6864"
                       Text="Kundenstammdaten für Projekte verwalten" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
            <Button Command="{Binding AddCommand}"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    Content="+ Neu" />
            <Button Command="{Binding EditCommand}" Content="Bearbeiten" />
            <Button Command="{Binding DeactivateCommand}" Content="Deaktivieren" />
            <Button Command="{Binding LoadCommand}" Content="Aktualisieren" />
            <Button Click="Exit_Click" Margin="12,0,0,0" Content="Beenden" />
        </StackPanel>

        <Border Grid.Row="2" Background="White"
                BorderBrush="#D8DEDB" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      BorderThickness="0" AlternatingRowBackground="#F7F9F8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                    <DataGridTextColumn Header="Kunde" Binding="{Binding Name}" Width="1.2*" />
                    <DataGridTextColumn Header="Straße" Binding="{Binding Street1}" Width="1.2*" />
                    <DataGridTextColumn Header="PLZ" Binding="{Binding PostalCode}" Width="80" />
                    <DataGridTextColumn Header="Ort" Binding="{Binding City}" Width="*" />
                    <DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="100" />
                    <DataGridTextColumn Header="Supplier-Nr." Binding="{Binding SupplierNumber}" Width="110" />
                    <DataGridTextColumn Header="Ansprechpartner" Binding="{Binding ContactPerson}" Width="1.2*" />
                    <DataGridTextColumn Header="Telefon" Binding="{Binding ContactPhone}" Width="120" />
                    <DataGridTextColumn Header="E-Mail" Binding="{Binding ContactEmail}" Width="1.2*" />
                    <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="90" />
                    <DataGridTextColumn Header="Geändert"
                                        Binding="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="160" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Foreground="#A12828" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <TextBlock HorizontalAlignment="Right" Foreground="#5B6864" Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</Window>
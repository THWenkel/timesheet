# =============================================================================
# backend/.env.example
#
# Environment variable template for the Timesheet backend.
#
# Copy this file to .env and fill in the values:
#   copy .env.example .env
#
# The .env file is git-ignored — never commit secrets to source control.
#
# ⚠️  ALL values marked with TODO must be changed before production deployment.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Database — Microsoft SQL Server
# ─────────────────────────────────────────────────────────────────────────────

# SQL Server hostname or IP address
DB_SERVER=dbserver01

# Target database name
DB_NAME=WiTERP

# SQL Server authentication — login username
# ⚠️  TODO: Replace 'sa' with a dedicated least-privilege SQL account before go-live
DB_USER=sa

# SQL Server authentication — login password
# ⚠️  TODO: Use a secrets manager (Azure Key Vault, etc.) instead of a .env file in production
DB_PASSWORD=strongpassword123!

# ODBC Encrypt setting — 'no' is required for SQL Server 2012 without TLS
# ⚠️  TODO: Change to 'yes' and configure a valid TLS certificate before production
DB_ENCRYPT=no

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────

# Set to true for verbose SQL logging (development only)
DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (JWT in an HttpOnly session cookie)
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to enforce login on all /api routes (except /api/auth/*, /health).
# First setup: keep false, create the administrator accounts in the admin client
# (username, "Administrator", "Einmalpasswort setzen"), then switch to true.
AUTH_ENABLED=false

# JWT signing secret. With AUTH_ENABLED=true the app refuses to start unless this
# has at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# Session lifetime in minutes (default 480 = one working day)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookies are only sent over HTTPS when true (keep true in production; TLS ends at
# the reverse proxy). Set false ONLY for local development over plain http://.
COOKIE_SECURE=true

# Origins allowed to call the API with cookies (JSON list). No wildcard.
CORS_ORIGINS=["http://localhost:5173"]

# Password rules and brute-force protection
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Build for path routing under /timesheet/ (IIS directly or behind the reverse proxy
# https://cloudserver2.hopto.org/timesheet/):
#   npm run build:path
# No secrets in this file (it is committed).

VITE_BASE_PATH=/timesheet/

# Deliberately set: overrides VITE_API_URL=http://localhost:8000 from .env, which would
# otherwise be baked into the bundle. API calls go to /timesheet/api/... on the same host.
VITE_API_URL=/timesheet

# Build for the own domain behind the reverse proxy (https://timesheet.wenkel.de/):
#   npm run build:domain
# No secrets in this file (it is committed).

# The app is served from the root of the domain; the proxy maps / to /timesheet/ on the IIS.
VITE_BASE_PATH=/

# Deliberately EMPTY: overrides VITE_API_URL=http://localhost:8000 from .env, which would
# otherwise be baked into the bundle. Empty means calls go to /api/... on the same domain.
VITE_API_URL=

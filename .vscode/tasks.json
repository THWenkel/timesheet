{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Validate frontend build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build",
				"--prefix",
				"frontend"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Deploy frontend to IIS",
			"type": "shell",
			"command": "Copy-Item",
			"args": [
				"-Path",
				"C:\\Apps\\timesheet\\frontend\\dist\\*",
				"-Destination",
				"C:\\inetpub\\wwwroot\\intranet.wenkel.local\\timesheet",
				"-Recurse",
				"-Force"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}